// ============================================
// FINANCE MANAGEMENT MODELS (PHASE 4)
// ============================================

model Payment {
  id String @id @default(cuid())

  // Student Information
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // Payment Details
  amount      Float // Using Float for SQLite compatibility
  paymentType String // Enum: MONTHLY_FEE, REGISTRATION_FEE, etc.
  category    String @default("MONTHLY_FEE") // Enum: MONTHLY_FEE, ONE_TIME_FEE...

  // Payment Status
  status      String  @default("PENDING") // Enum: PENDING, PAID, OVERDUE, PARTIALLY_PAID, CANCELLED, REFUNDED
  paymentMode String? // Enum: CASH, ONLINE, UPI, CHEQUE...

  // Dates
  dueDate     DateTime
  paymentDate DateTime?

  // Invoice & Receipt
  invoiceNumber String  @unique
  receiptNumber String? @unique
  receiptUrl    String?

  // Transaction Details
  transactionId String?
  chequeNumber  String?
  bankReference String?

  // Financial Tracking
  lateFee   Float @default(0)
  discount  Float @default(0)
  netAmount Float // amount - discount + lateFee

  // Metadata
  monthYear String? // "YYYY-MM"
  academyId String
  academy   Academy @relation(fields: [academyId], references: [id])
  batchId   String?
  batch     Batch?  @relation(fields: [batchId], references: [id])

  // Notes
  notes         String?
  internalNotes String?

  // Processing
  processedBy     String?
  processedByUser User?   @relation("PaymentsProcessed", fields: [processedBy], references: [id])

  // Reminders
  reminderSent   Boolean   @default(false)
  reminderSentAt DateTime?

  // Relations
  reminders PaymentReminder[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([paymentType])
  @@index([dueDate])
  @@index([paymentDate])
  @@index([monthYear])
  @@index([academyId])
  @@map("payments")
}

model FeeStructure {
  id          String  @id @default(cuid())
  name        String // "Beginner Standard"
  description String?

  // Fee Amounts
  monthlyFee      Float
  registrationFee Float

  // Applicability
  skillLevels  String? // JSON array
  academyTypes String? // JSON array
  ageMin       Int?
  ageMax       Int?

  // Status
  isActive      Boolean   @default(true)
  effectiveFrom DateTime
  effectiveTo   DateTime?

  // Creators
  createdBy     String?
  createdByUser User?   @relation(fields: [createdBy], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("fee_structures")
}

model PaymentReminder {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  reminderType String // Enum: UPCOMING, DUE_TODAY, GRACE_PERIOD, OVERDUE, FINAL_NOTICE
  sentAt       DateTime @default(now())
  sentVia      String? // JSON array ["email", "sms"]

  opened   Boolean   @default(false)
  openedAt DateTime?

  @@index([paymentId])
  @@index([studentId])
  @@map("payment_reminders")
}

model FinancialReport {
  id String @id @default(cuid())

  reportType String // Enum: MONTHLY, QUARTERLY, ANNUAL, CUSTOM
  period     String // "2024-01", "Q1-2024"

  // Summary
  totalRevenue Float
  totalPending Float
  totalOverdue Float

  // Breakdown
  revenueByType    String? // JSON
  revenueByAcademy String? // JSON

  // Metrics
  collectionRate Float
  averageRevenue Float
  studentCount   Int

  // Metadata
  generatedBy     String
  generatedByUser User   @relation(fields: [generatedBy], references: [id])

  // Timestamps
  generatedAt DateTime @default(now())

  @@index([reportType, period])
  @@map("financial_reports")
}

// ============================================
// PROGRESS & EVALUATION MODELS (PHASE 8)
// ============================================

model ProgressReport {
  id          String   @id @default(cuid())
  
  // Student & Coach
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  coachId     String
  coach       Coach    @relation(fields: [coachId], references: [id])
  
  // Assessment Details
  assessmentType String   @default("REGULAR") // REGULAR, LEVEL_ADVANCEMENT, COMPETITION_PREP
  date        DateTime @default(now())
  
  // Skill Level Snapshot
  currentLevel String // BEGINNER, INTERMEDIATE, ADVANCED
  recommendedLevel String?
  
  // Raw Performance Metrics
  speed       Int      // Jumps per minute
  endurance   Decimal  // Minutes (e.g., 4.50)
  freestyle   Int      // Number of tricks mastered
  doubleUnders Int     // Consecutive count
  
  // Additional Metrics
  crossovers  Int?
  power       Int?
  coordination Int?
  rhythm      Int?
  
  // Proficiency Scores (0-100 for progress bars)
  speedScore      Int  @default(0)
  enduranceScore  Int  @default(0)
  freestyleScore  Int  @default(0)
  doubleUndersScore Int @default(0)
  techniqueScore  Int  @default(0)
  
  // Overall Assessment
  overallScore    Int  @default(0)
  performanceGrade String @default("C") // A_PLUS, A, B_PLUS...
  
  // Coach Feedback
  feedback    String
  strengths   String?  // JSON array
  improvements String? // JSON array
  goals       String?  // JSON array
  
  // Comparison Data
  batchAverage Int?
  improvement  Int?
  
  // Metadata
  notes       String?
  videoUrl    String?
  attachments String?  // JSON array
  
  // Status
  status      String   @default("PUBLISHED") // DRAFT, PUBLISHED
  isPrivate   Boolean  @default(false)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([studentId])
  @@index([coachId])
  @@index([date])
  @@map("progress_reports")
}

model SkillMilestone {
  id              String    @id @default(cuid())
  
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id])
  
  milestoneType   String // SPEED_THRESHOLD, ENDURANCE_GOAL...
  skillCategory   String? // SPEED, ENDURANCE...
  
  // Milestone Details
  title           String
  description     String
  targetValue     Int
  achievedValue   Int
  unit            String
  
  // Achievement
  isAchieved      Boolean   @default(false)
  achievedDate    DateTime?
  
  // Recognition
  badge           String?
  points          Int       @default(0)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([studentId])
  @@index([isAchieved])
  @@map("skill_milestones")
}

model PerformanceTrend {
  id              String    @id @default(cuid())
  
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id])
  
  // Trend Period
  startDate       DateTime
  endDate         DateTime
  periodType      String // WEEKLY, MONTHLY
  
  // Aggregated Metrics
  avgSpeed        Decimal
  avgEndurance    Decimal
  avgFreestyle    Decimal
  avgDoubleUnders Decimal
  
  // Trend Analysis
  speedTrend      String // IMPROVING, STABLE, DECLINING
  enduranceTrend  String
  freestyleTrend  String
  doubleUndersTrend String
  
  // Improvement Metrics
  totalImprovement Int
  consistencyScore Int
  
  // Metadata
  reportCount     Int
  generatedAt     DateTime  @default(now())
  
  @@index([studentId])
  @@map("performance_trends")
}

// ============================================
// ATTENDANCE GAMIFICATION
// ============================================

model AttendanceStreak {
  id              String   @id @default(cuid())
  
  studentId       String   @unique
  student         Student  @relation("StudentAttendanceStreak", fields: [studentId], references: [id], onDelete: Cascade)
  
  // Streak Tracking
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastAttendanceDate DateTime?
  
  // Points & Achievements
  totalPoints     Int      @default(0)
  monthlyPoints   Int      @default(0)
  
  // Stats
  totalPresent    Int      @default(0)
  totalAbsent     Int      @default(0)
  totalLate       Int      @default(0)
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("attendance_streaks")
}

model AttendanceBadge {
  id              String   @id @default(cuid())
  
  studentId       String
  student         Student  @relation("StudentAttendanceBadges", fields: [studentId], references: [id], onDelete: Cascade)
  
  // Badge Details
  type            String   // PERFECT_WEEK, PERFECT_MONTH, HUNDRED_CLUB, EARLY_BIRD, COMEBACK_CHAMPION
  name            String   // "7 Day Champion", "Monthly Star", etc.
  description     String
  icon            String   // Emoji or icon name
  
  // Achievement
  earnedAt        DateTime @default(now())
  
  // Points awarded for this badge
  pointsAwarded   Int      @default(0)
  
  @@unique([studentId, type])
  @@index([studentId])
  @@index([type])
  @@map("attendance_badges")
}

model AttendanceLeaderboard {
  id              String   @id @default(cuid())
  
  studentId       String
  student         Student  @relation("StudentLeaderboard", fields: [studentId], references: [id], onDelete: Cascade)
  
  batchId         String
  batch           Batch    @relation("BatchLeaderboard", fields: [batchId], references: [id])
  
  // Period (e.g., "2026-02" for February 2026)
  period          String
  
  // Rankings
  rank            Int
  totalPoints     Int      @default(0)
  attendanceRate  Int      @default(0) // Percentage
  streakDays      Int      @default(0)
  
  // Metadata
  calculatedAt    DateTime @default(now())
  
  @@unique([studentId, batchId, period])
  @@index([batchId, period])
  @@index([rank])
  @@map("attendance_leaderboard")
}

// ============================================
// ID CARD MANAGEMENT MODELS
// ============================================

model IDCardHistory {
  id                String   @id @default(cuid())

  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Version Details
  version           Int
  cardSerialNumber  String

  // What Changed
  changes           String?  // JSON object of field changes
  changeReason      String?

  // Snapshot
  cardData          String?  // JSON full card data at this version

  // Metadata
  issuedBy          String?  // Admin user ID
  issuedAt          DateTime @default(now())
  validUntil        DateTime?

  // Status
  isCurrent         Boolean  @default(false)
  isRevoked         Boolean  @default(false)
  revokedReason     String?
  revokedAt         DateTime?

  @@index([studentId])
  @@index([version])
  @@map("id_card_history")
}

model IDCardRequest {
  id                String   @id @default(cuid())

  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Request Details
  requestType       String   // NEW_ISSUE, REPLACEMENT_LOST, REPLACEMENT_DAMAGED, REPLACEMENT_STOLEN, UPDATE_DETAILS
  reason            String

  // Lost/Damaged Details
  lastSeenDate      DateTime?
  lastSeenLocation  String?
  policeReportFiled Boolean  @default(false)
  policeReportNumber String?

  // Replacement Details
  urgency           String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  replacementFee    Float    @default(0)
  feePaid           Boolean  @default(false)

  // Status
  status            String   @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, CANCELLED
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?

  // Fulfillment
  newCardSerial     String?
  issuedAt          DateTime?

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@map("id_card_requests")
}

model IDCardScan {
  id                String   @id @default(cuid())

  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Scan Details
  scanType          String   // QR_CODE, BARCODE, NFC, MANUAL_ENTRY
  scanMethod        String?  // MOBILE_APP, WEB_PORTAL, PHYSICAL_SCANNER

  // Location
  locationName      String?  // "Main Gate", "Training Hall A"

  // Purpose
  purpose           String?  // ENTRY, EXIT, ATTENDANCE, VERIFICATION

  // Verification
  verificationStatus String  @default("VERIFIED") // VERIFIED, INVALID, EXPIRED, SUSPENDED

  // Access
  accessGranted     Boolean  @default(true)

  // Timestamps
  scannedAt         DateTime @default(now())

  @@index([studentId])
  @@index([scanType])
  @@index([scannedAt])
  @@map("id_card_scans")
}
